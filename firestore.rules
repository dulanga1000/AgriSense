rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read and write their own user documents and subcollections
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth.uid == uid;
    }

    // Specifically allow notifications subcollection (redundant but explicit)
    match /users/{uid}/notifications/{notificationId} {
      allow read: if request.auth.uid == uid;
      allow write: if request.auth.uid == uid || request.auth.token.firebase.sign_in_provider == 'custom';
    }

    // Allow disease_results (Cloud Functions write, admins read)
    match /disease_results/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.admin == true || 
                      (request.auth.token.firebase.sign_in_provider == 'service-account');
    }

    // Allow weather_alerts (Cloud Functions write, admins read)
    match /weather_alerts/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.admin == true || 
                      (request.auth.token.firebase.sign_in_provider == 'service-account');
    }

    // Allow crop_advisories (Cloud Functions write, admins read)
    match /crop_advisories/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.admin == true || 
                      (request.auth.token.firebase.sign_in_provider == 'service-account');
    }

    // Public collections
    match /crops/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.admin == true;
    }

    match /diseases/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.admin == true;
    }

    match /seasons/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.admin == true;
    }

    match /weather_models/{document=**} {
      allow read: if request.auth != null;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
